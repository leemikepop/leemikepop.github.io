---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap row mono">
    <span>© {year} {site.name} · {site.handle}</span>
    <span class="links">
      {site.links.map((l) => <a href={l.url}>{l.label.toLowerCase()}</a>)}
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>
