---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categories, type CategoryKey } from '../../data/site';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const counts = new Map<CategoryKey, number>();
for (const p of projects) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const used = (Object.keys(categories) as CategoryKey[]).filter((k) => counts.has(k));
---

<Base
  title="Projects"
  description="Projects by Mike (leemikepop): Android security, systems, AI and apps."
>
  <div class="wrap">
    <header class="head">
      <p class="mono crumb"><span class="ps">$</span> ls ./projects</p>
      <h1>Projects</h1>
      <p class="lead">
        Research, internships, industry collaborations and side projects. Repos marked
        <span class="badge private">private</span> are not open source — open the project for a
        write-up.
      </p>
    </header>

    <div class="filters mono" role="toolbar" aria-label="Filter by category">
      <button type="button" data-filter="all" aria-pressed="true">
        all <span class="n">{projects.length}</span>
      </button>
      {
        used.map((k) => (
          <button type="button" data-filter={k} aria-pressed="false">
            {categories[k]} <span class="n">{counts.get(k)}</span>
          </button>
        ))
      }
    </div>

    <div class="grid" id="project-grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .card');

  function apply(filter: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    cards.forEach((c) => {
      c.hidden = filter !== 'all' && c.dataset.category !== filter;
    });
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter ?? 'all';
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `#${f}`);
    }),
  );

  const initial = location.hash.slice(1);
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>

<style>
  .head {
    margin-bottom: 2rem;
  }
  .crumb {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ps {
    color: var(--ok);
  }
  h1 {
    margin: 0.3rem 0 0.6rem;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    line-height: 1.2;
  }
  .lead {
    margin: 0;
    max-width: 44rem;
    color: var(--text-dim);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filters button {
    font: inherit;
    font-size: 0.8rem;
    color: var(--text-dim);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
  }
  .filters button:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .filters button[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .n {
    opacity: 0.6;
    margin-left: 0.2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }
  .grid :global(.card[hidden]) {
    display: none;
  }
</style>
