---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, experience, education } from '../data/site';
import { getProjects, getFeatured, getNotes, formatDate } from '../lib/content';

const projects = await getProjects();
const featured = await getFeatured();
const notes = (await getNotes()).slice(0, 4);
---

<Base>
  <section class="wrap hero">
    <div class="term" role="img" aria-label={`${site.name} (${site.handle}): ${site.headline}`}>
      <div class="term-bar" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="term-title mono">~/whoami</span>
      </div>
      <div class="term-body mono" aria-hidden="true">
        <p><span class="ps">$</span> whoami</p>
        <h1>
          <span class="name">{site.name}</span>
          <span class="handle">@{site.handle}</span>
        </h1>
        <p class="headline">{site.headline}</p>
        <p class="gap"><span class="ps">$</span> cat about.txt</p>
        <p class="out">{site.intro}</p>
        <p class="gap"><span class="ps">$</span> ls focus/</p>
        <p class="out focus">{site.focus.map((f) => <span>{f}</span>)}</p>
        <p class="gap"><span class="ps">$</span> <span class="cursor"></span></p>
      </div>
    </div>
    <ul class="hero-links mono">
      {
        site.links.map((l) => (
          <li>
            <a href={l.url} rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li class="loc">{site.location}</li>
    </ul>
  </section>

  <section class="wrap block">
    <h2 class="section-title">featured projects</h2>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="more mono">
      <a href="/projects/">ls ./projects --all → ({projects.length})</a>
    </p>
  </section>

  <section class="wrap block">
    <h2 class="section-title">experience</h2>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li>
            <div class="when mono">{e.period}</div>
            <div class="what">
              <h3>{e.title}</h3>
              <p class="org">{e.org}</p>
              <ul>
                {e.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="wrap block split">
    <section>
      <h2 class="section-title">education</h2>
      <ul class="plain">
        {
          education.map((ed) => (
            <li>
              <strong>{ed.school}</strong>
              <span class="dim">{ed.degree}</span>
              <span class="mono small">{ed.period}</span>
            </li>
          ))
        }
      </ul>
    </section>
    {
      notes.length > 0 && (
        <section>
          <h2 class="section-title">recent notes</h2>
          <ul class="plain">
            {notes.map((n) => (
              <li>
                <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                <span class="mono small">{formatDate(n.data.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    padding-top: 1rem;
  }
  .term {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term-title {
    margin-left: 0.6rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .term-body {
    padding: 1.25rem 1.1rem 1.4rem;
    font-size: 0.85rem;
    line-height: 1.75;
  }
  @media (min-width: 720px) {
    .term-body {
      padding: 1.75rem 2rem 2rem;
      font-size: 0.92rem;
    }
  }
  .term-body p {
    margin: 0;
  }
  .gap {
    margin-top: 1rem !important;
  }
  .ps {
    color: var(--ok);
    user-select: none;
  }
  h1 {
    margin: 0.4rem 0 0.1rem;
    font-size: clamp(1.9rem, 6vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
  }
  .name {
    font-weight: 600;
    color: var(--text);
  }
  .handle {
    font-size: 0.55em;
    font-weight: 400;
    color: var(--accent);
  }
  .headline {
    color: var(--text-dim);
  }
  .out {
    color: var(--text-dim);
    max-width: 52rem;
  }
  .focus {
    font-family: var(--mono);
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--text);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hero-links {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.82rem;
  }
  .loc {
    color: var(--muted);
  }

  .block {
    margin-top: 4rem;
  }
  .grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .more {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline > li {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .timeline > li:last-child {
    border-bottom: 0;
  }
  @media (min-width: 720px) {
    .timeline > li {
      grid-template-columns: 11rem 1fr;
    }
  }
  .when {
    font-size: 0.78rem;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .what h3 {
    margin: 0;
    font-size: 1rem;
  }
  .org {
    margin: 0.1rem 0 0.4rem;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .what ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .split {
    display: grid;
    gap: 3rem 2.5rem;
  }
  @media (min-width: 820px) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plain li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .dim {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .small {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
