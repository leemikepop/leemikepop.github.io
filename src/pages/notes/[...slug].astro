---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate, type Note } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="wrap">
    <p class="mono crumb">
      <a href="/notes/">notes</a><span class="sep">/</span><span>{note.id}</span>
    </p>
    <h1>{note.data.title}</h1>
    <p class="mono meta">
      {formatDate(note.data.date)}
      {note.data.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <div class="prose">
      <Content />
    </div>
    <p class="mono back"><a href="/notes/">← cd ..</a></p>
  </article>
</Base>

<style>
  .crumb {
    margin: 0 0 1.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .sep {
    margin: 0 0.4rem;
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    line-height: 1.3;
    max-width: 46rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .back {
    margin-top: 3rem;
    font-size: 0.85rem;
  }
</style>
